  "private": true,
  "description": "A headline river of Washington Commanders news, pulled nightly from the team's own site plus national and blog coverage.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "collect": "node src/cli.js collect",
    "social": "node src/cli.js social",
    "build": "node src/cli.js build",
    "run": "node src/cli.js run",
    "serve": "node src/cli.js serve",
    "sources": "node src/cli.js sources",
    "doctor": "node src/cli.js doctor",
    "status": "node src/cli.js status",
    "roster": "node src/cli.js roster",
    "schedule": "node src/cli.js schedule",
    "digest": "node src/cli.js digest",
