# All optional. Copy to .env to override any default.

# Shown in the page footer, feeds, and canonical URLs.
SITE_NAME=The Burgundy Wire
SITE_URL=http://localhost:8080

# Timezone used to format displayed timestamps.
SITE_TZ=America/New_York

# Drop items older than this on first sight (days).
MAX_ITEM_AGE_DAYS=14

# Per-source cap per run, and politeness delay between requests to the same host (ms).
MAX_ITEMS_PER_SOURCE=15
FETCH_DELAY_MS=700
